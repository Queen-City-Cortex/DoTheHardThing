{
  // The Worker and the one app module it shares (the event list). `npm run build` runs `tsc -b`, which includes this
  // config, so a type error in worker/index.ts or src/events.ts now fails the production build and blocks the deploy.
  // worker/index.test.ts is left out on purpose so a test stub cannot block a deploy (Vitest still runs it).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["worker/index.ts", "src/events.ts"]
}
