{
  "name": "do-the-hard-thing",
  "description": "A morning method as an offline-first PWA: name what you are avoiding, pick one thing, protect one block.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "Jeffery Hoffman (Queen City Cortex)",
  "homepage": "https://dothehardthing.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Queen-City-Cortex/DoTheHardThing.git"
  },
  "bugs": {
    "url": "https://github.com/Queen-City-Cortex/DoTheHardThing/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-text.mjs",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:text": "node scripts/check-text.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:agents-md": "node scripts/check-agents-md.mjs",
    "check:quotes": "node scripts/check-method-quotes.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "check:og": "node scripts/check-og.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:fast": "node scripts/check.mjs fast",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs full",
    "journeys": "node e2e/run.mjs --serve",
    "journeys:fast": "node e2e/run.mjs --serve --fast",
    "gaps": "node e2e/gaps.mjs --serve",
    "mutate": "node scripts/mutate.mjs",
    "vacuous": "node scripts/vacuous.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@babel/core": "^7.0.0"
  }
}
