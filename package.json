{
  "name": "do-the-hard-thing",
  "description": "A morning method as an offline-first PWA: name what you are avoiding, pick one thing, protect one block.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "Jeffery Hoffman (Queen City Cortex)",
  "homepage": "https://dothehardthing.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Queen-City-Cortex/DoTheHardThing.git"
  },
  "bugs": {
    "url": "https://github.com/Queen-City-Cortex/DoTheHardThing/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:agents-md": "node scripts/check-agents-md.mjs",
    "check:quotes": "node scripts/check-method-quotes.mjs",
    "check:fast": "node scripts/check.mjs fast",
    "check": "node scripts/check.mjs",
    "check:full": "node scripts/check.mjs full",
    "journeys": "node e2e/run.mjs --serve",
    "journeys:fast": "node e2e/run.mjs --serve --fast",
    "verify:live": "node scripts/verify-live.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.64.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
